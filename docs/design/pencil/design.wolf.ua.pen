              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "jmdPZ",
              "name": "Опис",
              "fill": "$text-2",
              "textGrowth": "fixed-width",
              "width": 880,
              "content": "Основа — дизайн-система calendar.wolf.ua: ті самі токени, Lora для заголовків і Manrope для інтерфейсу, кнопки, поля, модальне вікно, нижній лист і тост. Нове для Майстерні — статуси замовлення, рядок «чий хід», картки, записи стрічки, поле введення з відповіддю, рядки макетів і блок ціни.",
              "lineHeight": 1.55,
              "fontFamily": "$font-ui",
              "fontSize": 17,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "dBiL6",
              "name": "Що змінено відносно calendar",
              "width": "fill_container",
              "fill": "$blue-soft",
              "cornerRadius": 12,
              "layout": "vertical",
              "gap": 14,
              "padding": [
                18,
                22
              ],
              "children": [
                {
                  "type": "text",
                  "id": "wUeXk",
                  "name": "Т",
                  "fill": "$blue-pressed",
                  "content": "Що змінено для робочого інструмента",
                  "fontFamily": "$font-ui",
                  "fontSize": 15,
                  "fontWeight": "800"
                },
                {
                  "type": "frame",
