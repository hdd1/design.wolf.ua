                      "name": "Т",
                      "fill": "$text",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Lora тільки на публічних сторінках і заголовках сторінок; у робочому просторі й кабінетах — лише Manrope, щоб інтерфейс не сперечався з макетами клієнта.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
